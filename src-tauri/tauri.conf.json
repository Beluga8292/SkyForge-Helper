{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkyBlock Companion",
  "version": "0.5.0-rc.6",
  "identifier": "com.skyblock.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build -- --emptyOutDir false",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SkyForge Helper",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "theme": "Dark",
        "backgroundColor": "#0A0B0F"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https://mc-heads.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://updates.plasmavpn.online ipc: http://ipc.localhost https://api.hypixel.net https://api.mojang.com https://piston-meta.mojang.com https://launchermeta.mojang.com https://resources.download.minecraft.net https://textures.minecraft.net; script-src 'self'",
      "devCsp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' http://localhost:1420 ws://localhost:1420 http://127.0.0.1:8000 http://127.0.0.1:18080 http://localhost:18080 ipc: http://ipc.localhost https://api.hypixel.net https://api.mojang.com; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Hypixel SkyBlock market and profile companion",
    "longDescription": "SkyForge Helper is a desktop Hypixel SkyBlock companion with profiles, Bazaar analytics, Auction House browsing, calculators, progression and a watchlist.",
    "copyright": "Copyright (c) 2026 Beluga_8292",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true,
    "license": "MIT",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../docs/third-party/DEPENDENCY-LICENSES.txt": "licenses/DEPENDENCY-LICENSES.txt",
      "../docs/third-party/NEU-LICENSE.txt": "licenses/NEU-LICENSE.txt"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Beluga8292/SkyForge-Helper/releases/download/rc-channel/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFRkM3RThFODQ0RjA0NjMKUldSakJFK0Vqbjc4anFFSWdUNWk5MTBOSDEyVXVGMGduZDFwdkRhK05jd0pvekRRZFhTekROOTgK",
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
