{
  "name": "skyblock-companion",
  "private": true,
  "version": "0.5.0-rc.5",
  "type": "module",
  "description": "SkyForge Helper — desktop companion for Hypixel SkyBlock",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/configure-backend.mjs && tauri build --config src-tauri/tauri.backend.generated.json",
    "tauri:rc": "node scripts/build-rc.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "publish:update": "node scripts/publish-update.mjs"
  },
