# SkyForge Helper backend — copy to backend/.env and fill in locally.
# NEVER commit backend/.env. The Hypixel key must exist only on the server.

# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# --- Hypixel / Mojang ------------------------------------------------------
# Required for /players and /profiles. Bazaar and resources work without it,
# but profile endpoints return 503 hypixel_key_missing instead of fake data.
HYPIXEL_API_KEY=
HYPIXEL_BASE_URL=https://api.hypixel.net/v2
MOJANG_BASE_URL=https://api.mojang.com
HTTP_TIMEOUT_SECONDS=15
HTTP_CONNECT_TIMEOUT_SECONDS=5
UPSTREAM_MAX_RETRIES=2
# Hypixel's documented default is 120 requests/minute per key. Never raise this
# above 120 or try to rotate multiple keys to bypass the limit.
UPSTREAM_RATE_LIMIT_PER_MINUTE=110
UPSTREAM_QUEUE_SIZE=200

# --- Redis cache -----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CACHE_PREFIX=sbc:v1
CACHE_TTL_BAZAAR=20
CACHE_TTL_AUCTIONS=45
CACHE_TTL_PLAYER=90
CACHE_TTL_PROFILES=90
CACHE_TTL_RESOURCES=43200
CACHE_STALE_SECONDS=3600
CACHE_SWR_ENABLED=true
CACHE_MAX_PAYLOAD_BYTES=67108864

# --- Public API protection -------------------------------------------------
BACKEND_RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BODY_BYTES=1048576
# JSON array. Desktop origins are Tauri URLs, not a shared secret.
CORS_ORIGINS=["http://localhost:1420","http://127.0.0.1:1420","tauri://localhost","https://tauri.localhost"]
# Only list reverse-proxy IPs here; X-Forwarded-For from others is ignored.
TRUSTED_PROXY_IPS=[]

# --- PostgreSQL ------------------------------------------------------------
# Local native run (docker compose overrides this host to `postgres`):
DATABASE_URL=postgresql+asyncpg://skyblock:skyblock@localhost:5432/skyblock
POSTGRES_USER=skyblock
POSTGRES_PASSWORD=change-me
POSTGRES_DB=skyblock
DATABASE_POOL_SIZE=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_ECHO=false
# Never enable in production. Use `alembic upgrade head`.
AUTO_CREATE_TABLES=false

# --- Auctions, history, workers -------------------------------------------
AUCTION_REFRESH_SECONDS=45
AUCTION_FETCH_CONCURRENCY=4
AUCTION_MAX_PAGES=100
AUCTION_SNAPSHOT_STALE_SECONDS=600
AUCTION_API_MAX_PAGE_SIZE=100
HISTORY_INTERVAL_SECONDS=300
HISTORY_RAW_RETENTION_HOURS=168
HISTORY_HOURLY_RETENTION_DAYS=30
HISTORY_MAX_POINTS=5000
CLEANUP_INTERVAL_SECONDS=21600
AGGREGATE_INTERVAL_SECONDS=3600

# --- Reverse proxy / Docker ------------------------------------------------
# Set to the reverse proxy container IP or network when running behind Caddy.
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional local single-process worker, shares the API container budget.
# Only development + REDIS_URL empty; never combine with a separate worker process.
RUN_LOCAL_WORKER=false
