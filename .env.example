# Public build configuration only. Never put a Hypixel key in VITE_*.
# Desktop BYOK is stored in the OS credential vault; backend keys belong in backend/.env.
# Leave unset until a real backend has been configured. There is no default public domain.
VITE_BACKEND_URL=
# Browser development proxy only:
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000
# To configure production desktop permissions as well as the client URL:
# VITE_BACKEND_URL=https://<your-real-host> npm run tauri:build
